# Only the interactive demo needs a model. Tests and the eval harness run
# offline and need nothing here.
#
# This file is not loaded automatically. Export the variables, or load it with:
#   set -a; source .env; set +a

# Option 1: OpenAI
OPENAI_API_KEY=

# Option 2: any OpenAI-compatible endpoint. The demo switches to the Chat
# Completions API and disables OpenAI tracing whenever OPENAI_BASE_URL is set.
# Example for DeepSeek:
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_DEFAULT_MODEL=deepseek-flash
# OPENAI_API_KEY=<your provider key>
